<?xml version="1.0"?>
<rdf:RDF xmlns="https://saldubatech.github.io/manufacturing-ontologies/templates/owl2-model-template#"
     xml:base="https://saldubatech.github.io/manufacturing-ontologies/templates/owl2-model-template"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://saldubatech.github.io/manufacturing-ontologies/templates/owl2-model-template">
        <owl:versionIRI rdf:resource="https://saldubatech.github.io/manufacturing-ontologies/templates/owl2-model-template/0.1.0"/>
        <dcterms:title>OWL 2 model template</dcterms:title>
        <dcterms:description>Starter ontology for developing OWL 2 models with Protege Desktop. Update the ontology IRI, version IRI, and placeholder entities before reuse.</dcterms:description>
        <dcterms:creator>Saldubatech</dcterms:creator>
        <owl:versionInfo>0.1.0</owl:versionInfo>
    </owl:Ontology>

    <owl:Class rdf:about="#ManufacturingEntity">
        <rdfs:label>manufacturing entity</rdfs:label>
        <rdfs:comment>Top-level placeholder class for the ontology.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ManufacturingProcess">
        <rdfs:subClassOf rdf:resource="#ManufacturingEntity"/>
        <rdfs:label>manufacturing process</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#ManufacturingResource">
        <rdfs:subClassOf rdf:resource="#ManufacturingEntity"/>
        <rdfs:label>manufacturing resource</rdfs:label>
    </owl:Class>

    <owl:ObjectProperty rdf:about="#usesResource">
        <rdfs:domain rdf:resource="#ManufacturingProcess"/>
        <rdfs:range rdf:resource="#ManufacturingResource"/>
        <rdfs:label>uses resource</rdfs:label>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="#hasIdentifier">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="#ManufacturingEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has identifier</rdfs:label>
    </owl:DatatypeProperty>

    <owl:NamedIndividual rdf:about="#ExampleProcess">
        <rdf:type rdf:resource="#ManufacturingProcess"/>
        <usesResource rdf:resource="#ExampleResource"/>
        <hasIdentifier>PROCESS-001</hasIdentifier>
        <rdfs:label>example process</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#ExampleResource">
        <rdf:type rdf:resource="#ManufacturingResource"/>
        <hasIdentifier>RESOURCE-001</hasIdentifier>
        <rdfs:label>example resource</rdfs:label>
    </owl:NamedIndividual>
</rdf:RDF>
